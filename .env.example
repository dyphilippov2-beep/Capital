# Copy this file to .env (next to it) and fill in. .env is not stored in git.

# Telegram: bot from @BotFather, added as admin of the channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@titanhockeylab

# Claude picks the clips with a logical start and end (console.anthropic.com)
ANTHROPIC_API_KEY=

# Autopilot (shorts/auto.py): channel link or a link to any of its videos
YOUTUBE_CHANNEL=https://www.youtube.com/channel/UC8p1uw85dvpBvRMxBbYFF1A
# Where to post: telegram,youtube,vk
PUBLISH_TO=telegram
# YouTube visibility for autoposts: public / unlisted / private
YOUTUBE_PRIVACY=public

# Links to all your social networks, added under every short (separator " | ").
# The link to the network where the post is published is skipped automatically.
SOCIAL_LINKS=Telegram: https://t.me/titanhockeylab | YouTube: https://www.youtube.com/channel/UC8p1uw85dvpBvRMxBbYFF1A | Rutube: https://rutube.ru/channel/23890442/
# Line before the links (optional)
SOCIAL_CTA=

# VK (optional)
VK_TOKEN=
VK_GROUP_ID=
